APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Local SQLite (Default for quick local test runs)
DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database.sqlite

# Local MySQL Configuration (Recommended for local dev)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketpilot
# DB_USERNAME=root
# DB_PASSWORD=

# Production Supabase PostgreSQL Configuration
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-[region].pooler.supabase.com
# DB_PORT=5432 # or 6543 (transaction pooler)
# DB_DATABASE=postgres
# DB_USERNAME=postgres.[project-ref]
# DB_PASSWORD="your-supabase-db-password"
# DB_SCHEMA=public
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Filesystem Storage Configuration
# Local Development: FILESYSTEM_DISK=public (stores in storage/app/public)
# Production / Vercel: FILESYSTEM_DISK=s3 (persists in Supabase Storage / S3)
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development mail: use a Gmail SMTP sender so verification emails can be delivered
# to real Gmail recipients. Create an app password in Google account settings first.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-gmail-address@gmail.com"
MAIL_PASSWORD="your-gmail-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-gmail-address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Production S3 / Supabase Storage Configuration (Required when FILESYSTEM_DISK=s3)
# Supabase S3 Endpoint format: https://<project-ref>.supabase.co/storage/v1/s3
# Supabase Public Object URL: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=marketpilot-assets
AWS_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
AWS_URL=https://[project-ref].supabase.co/storage/v1/object/public/marketpilot-assets
AWS_USE_PATH_STYLE_ENDPOINT=true

OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

